# Questling server configuration — placeholders only. Copy to .env and fill locally.
# Never commit .env. Never put these values in client code (no VITE_ prefix for secrets).
PORT=8787
NODE_ENV=development
# Public base URL of this server (used for OAuth redirect and the link page)
APP_BASE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins for CORS (CORS is not authorization)
ALLOWED_ORIGINS=http://localhost:5173

# --- AI: Gemini (default provider) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- AI: optional extra providers ---
# Each provider turns on only when BOTH its key and model are set (Ollama: model only).
# Keys stay on this server; the phone only ever sees provider ids and model names.
# Pick models that support structured (JSON-schema) output. Check each vendor's current model list.
# Which configured provider answers when the user leaves the picker on "Automatic":
AI_DEFAULT_PROVIDER=gemini
# OpenAI (Chat Completions + json_schema; voice via the transcription endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Anthropic Claude (Messages API, forced tool call for structure). Text only; voice is routed to a voice-capable provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# OpenRouter (one key, many models; routed only to endpoints that honour response_format). Text only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Ollama (self-hosted next to this server, no key). Text only. Never point this at an untrusted host.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Google Calendar OAuth (Web application client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# --- Task integrations (optional) ---
# Each uses an external-browser OAuth link like Calendar; tokens live only in server memory.
# Google Tasks reuses the Google client above (add the Tasks API in Google Cloud; same redirect URI).
GOOGLE_TASKS_ENABLED=true
# Todoist: create an app at the Todoist App Management Console; redirect URL = <APP_BASE_URL>/api/auth/todoist/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Notion: create a public connection (OAuth); redirect URI = <APP_BASE_URL>/api/auth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Mail & chat (optional) ---
# Gmail reuses the Google client above: enable the Gmail API and add scopes gmail.metadata + gmail.send
# (same redirect URI). Questling reads sender + subject only and sends replies only after you confirm.
GMAIL_ENABLED=true
# Slack: create an app in YOUR workspace (api.slack.com/apps), user scopes search:read, chat:write, users:read;
# redirect URL = <APP_BASE_URL>/api/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Telegram: nothing to register here — each user pastes their OWN bot token on the /link page.
# Set to false to hide Telegram. (TELEGRAM_API_BASE only for tests.)
TELEGRAM_ENABLED=true
# GitHub: each user pastes a classic token with ONLY the `notifications` scope on the /link page. Set false to hide.
GITHUB_ENABLED=true

# --- Demo / cost protection ---
# Operator access codes for AI/Calendar/task endpoints (comma-separated). Required when NODE_ENV=production.
ACCESS_CODES=
# Global AI request budget per UTC day (in-memory, resets on restart)
AI_DAILY_BUDGET=300
# Per-client AI requests per minute
AI_RATE_PER_MINUTE=12

# --- Client build (public, not secret) ---
# API origin baked into the packaged .ehpk build. Leave empty to use same-origin.
VITE_API_BASE_URL=
